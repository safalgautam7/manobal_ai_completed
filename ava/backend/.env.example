# Copy to `.env` and fill in real values.

# --- LLM provider ---
# Set LLM_PROVIDER=ollama to use a local model (requires `ollama serve`).
# Set LLM_PROVIDER=groq and GROQ_API_KEY to use the hosted Groq API.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
GROQ_API_KEY=
LLM_MODEL=mixtral-8x7b-32768
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=./data/vector_store
RETRIEVER_K=4
RETRIEVER_MIN_SCORE=0.35

# Conversation memory
MAX_CONVERSATIONS=30
MAX_INPUT_CHARS=2000

# Storage
DATABASE_PATH=./data/manobal.db

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Clerk auth
# AUTH_ENABLED=true
# CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# CLERK_AUDIENCE=manobal-frontend
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# Emotion analysis
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
EMOTION_DEVICE=cpu

# Quotes
QUOTES_FILE=./data/mental_health_quotes.txt